generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase "Transaction" pooler, port 6543) used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) used for migrations / `prisma db push`.
  directUrl = env("DIRECT_URL")
}

model Part {
  id                 String        @id @default(cuid())
  name               String
  partNumber         String        @unique
  manufacturer       String
  modelNumber        String?
  serialNumber       String?
  totalQuantity      Int           @default(0)
  reservedQuantity   Int           @default(0)
  location           String
  aisle              String?
  shelf              String?
  bin                String?
  condition          String        @default("New")
  warrantyExpiration DateTime?
  notes              String?
  imageUrl           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  reservations       Reservation[]
  activities         Activity[]

  @@index([manufacturer])
  @@index([modelNumber])
  @@index([location, aisle, shelf, bin])
  @@index([updatedAt])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  status       String        @default("Active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  activities   Activity[]

  @@index([status])
}

model Reservation {
  id        String   @id @default(cuid())
  partId    String
  projectId String
  quantity  Int
  status    String   @default("Reserved")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([partId, status])
  @@index([projectId, status])
  @@index([createdAt])
}

model Activity {
  id          String         @id @default(cuid())
  type        ActivityType
  details     String?
  partId      String?
  projectId   String?
  actorId     String?
  source      ActivitySource @default(WEB)
  metadata    Json?
  createdAt   DateTime       @default(now())
  part        Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor       AppUser?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([partId, createdAt])
  @@index([projectId, createdAt])
}

model AppUser {
  id          String     @id
  email       String     @unique
  displayName String?
  role        UserRole   @default(WORKER)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  Activity[]
  scanUsage   ScanUsage[]
}

model ScanUsage {
  id        String   @id @default(cuid())
  userId    String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

enum ActivityType {
  PART_CREATED
  PART_UPDATED
  PART_DELETED
  QUANTITY_ADDED
  QUANTITY_REMOVED
  PART_MOVED
  RESERVATION_CREATED
  RESERVATION_UPDATED
  RESERVATION_READY
  RESERVATION_CANCELLED
  PART_PICKED_UP
  PART_RETURNED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  INVENTORY_IMPORTED
  INVENTORY_EXPORTED
  USER_INVITED
  USER_ROLE_CHANGED
}

enum UserRole {
  ADMIN
  MANAGER
  WORKER
}

enum ActivitySource {
  WEB
  SCAN
  IMPORT
  SYSTEM
}
